{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "svitlo",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // One Worker serves the whole site: static files from ../web (free, not
  // counted as Worker requests) and the code for /api and /tg only.
  // workers.dev is off: the edge cache does not work there.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "svitlo.yanasworks.com", "custom_domain": true }],
  "assets": {
    "directory": "../web",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/tg/*"]
  },

  // D1 database (production in region EEUR). Local dev uses a local copy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "svitlo-db",
      "database_id": "4be4e6b2-5b65-452d-bee1-b750fab3dc4e",
      "migrations_dir": "migrations"
    }
  ],

  // Per-chat limit for the Telegram bot: 30 updates a minute.
  "ratelimits": [
    { "name": "BOT_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],

  // Alert fan-out (Step 6): one message = up to 40 chats; one at a time keeps
  // the send rate under Telegram's limit.
  "queues": {
    "producers": [{ "binding": "ALERTS", "queue": "svitlo-alerts" }],
    "consumers": [{ "queue": "svitlo-alerts", "max_batch_size": 1, "max_retries": 3, "max_concurrency": 1 }]
  },

  // Status logic runs every minute (Step 3).
  "triggers": { "crons": ["* * * * *"] }
}
