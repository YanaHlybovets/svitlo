{
  "name": "svitlo-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply svitlo-db --local",
    "deploy": "wrangler deploy",
    "sensor-key": "node scripts/sensor-key.ts",
    "fake-sensor": "node scripts/fake-sensor.ts",
    "db:migrate:remote": "wrangler d1 migrations apply svitlo-db --remote",
    "tail": "wrangler tail",
    "telegram-setup": "node scripts/telegram-setup.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.3",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.163.0"
  }
}
